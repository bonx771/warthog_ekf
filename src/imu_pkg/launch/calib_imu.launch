<launch>
  <arg name="serial_port" default="/dev/ttyUSB0" />
  <arg name="baud_rate" default="115200" />
  <arg name="serial_timeout_sec" default="0.05" />
  <arg name="startup_command_delay_sec" default="0.05" />
  <arg name="stream_output_hz" default="50" />
  <arg name="stream_data_mask" default="1" />
  <arg name="calibration_duration_sec" default="480.0" />
  <arg name="ready_check_timeout_sec" default="10.0" />
  <arg name="imu_topic" default="/imu/data_new" />
  <arg name="auto_start" default="true" />
  <arg name="keyboard_start_enabled" default="false" />

  <node pkg="imu_pkg"
        type="calib_imu.py"
        name="calib_imu"
        output="screen">
    <param name="serial_port" value="$(arg serial_port)" />
    <param name="baud_rate" value="$(arg baud_rate)" />
    <param name="serial_timeout_sec" value="$(arg serial_timeout_sec)" />
    <param name="startup_command_delay_sec" value="$(arg startup_command_delay_sec)" />
    <param name="stream_output_hz" value="$(arg stream_output_hz)" />
    <param name="stream_data_mask" value="$(arg stream_data_mask)" />
    <param name="calibration_duration_sec" value="$(arg calibration_duration_sec)" />
    <param name="ready_check_timeout_sec" value="$(arg ready_check_timeout_sec)" />
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="auto_start" value="$(arg auto_start)" />
    <param name="keyboard_start_enabled" value="$(arg keyboard_start_enabled)" />
    <param name="send_stop_before_stream" value="true" />
    <param name="send_gyrocompass_start" value="true" />
  </node>
</launch>
