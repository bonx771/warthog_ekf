<?xml version="1.0"?>
<launch>

  <param name="/outdoor_waypoint_nav/safety_enabled" value="true" type="bool" />
  <param name="/outdoor_waypoint_nav/safety_input_cmd_topic" value="/cmd_vel_intermediate" type="string" />
  <param name="/outdoor_waypoint_nav/safety_output_cmd_topic" value="/cmd_vel" type="string" />
  <param name="/outdoor_waypoint_nav/safety_scan_topic" value="/front/scan" type="string" />
  <param name="/outdoor_waypoint_nav/safety_plan_topic" value="/move_base/NavfnROS/plan" type="string" />
  <param name="/outdoor_waypoint_nav/safety_replan_topic" value="/outdoor_waypoint_nav/replan_requested" type="string" />
  <param name="/outdoor_waypoint_nav/safety_obstacle_distance" value="1.6" type="double" />
  <param name="/outdoor_waypoint_nav/safety_sector_half_angle_deg" value="45.0" type="double" />
  <param name="/outdoor_waypoint_nav/safety_turn_angle_deg" value="30.0" type="double" />
  <param name="/outdoor_waypoint_nav/safety_forward_distance" value="2.0" type="double" />
  <param name="/outdoor_waypoint_nav/safety_turn_speed" value="0.45" type="double" />
  <param name="/outdoor_waypoint_nav/safety_forward_speed" value="0.45" type="double" />
  <param name="/outdoor_waypoint_nav/safety_maneuver_cooldown" value="1.0" type="double" />
  <param name="/outdoor_waypoint_nav/safety_path_lookahead_distance" value="1.0" type="double" />
  <param name="/outdoor_waypoint_nav/safety_odom_frame" value="odom" type="string" />
  <param name="/outdoor_waypoint_nav/safety_base_frame" value="base_link" type="string" />

  <node ns="/outdoor_waypoint_nav" pkg="outdoor_waypoint_nav" type="safety_node" name="safety_node" output="screen"/>

</launch>
